# ============================================================
# STARCROSS — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ============================================================

# ─────────────────────────────────────────────
# SUPABASE
# Found in: Supabase Dashboard > Project Settings > API
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─────────────────────────────────────────────
# RESEND (Email Service)
# Found in: resend.com > API Keys
# ─────────────────────────────────────────────
RESEND_API_KEY=re_your-resend-api-key

# ─────────────────────────────────────────────
# EMAIL ADDRESSES
# ─────────────────────────────────────────────
RESEND_FROM_EMAIL=noreply@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# ─────────────────────────────────────────────
# VERCEL CRON PROTECTION
# Generate a strong random secret: openssl rand -base64 32
# Add the same value in Vercel Dashboard > Project Settings > Environment Variables
# ─────────────────────────────────────────────
CRON_SECRET=your-strong-random-cron-secret

# ─────────────────────────────────────────────
# GOOGLE ANALYTICS 4 & VERCEL ANALYTICS
# Found in: analytics.google.com > Admin > Data Streams > Measurement ID
# Set NEXT_PUBLIC_ANALYTICS_ENABLED=false to completely disable all analytics for privacy/compliance
# ─────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_ANALYTICS_ENABLED=true

# ─────────────────────────────────────────────
# SITE CONFIG
# ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ─────────────────────────────────────────────
# RATE LIMITING
# Maximum booking/contact form submissions per IP per minute
# ─────────────────────────────────────────────
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000
